<Window x:Class="OffMindApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Off-Mind" Height="720" Width="1200" WindowStartupLocation="CenterScreen" Background="#FF0E0F13">
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1A1D26" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF2A2F3D" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#FF5B2EFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF1A1D26" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#2E3443" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FF12141C" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Ellipse Width="36" Height="36" Fill="#FF5B2EFF" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Off-Mind" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Music Studio" Foreground="#9DA3B4" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource SidebarButton}" Content="Inicio" />
                <Button Style="{StaticResource SidebarButton}" Content="Buscar" />
                <Button Style="{StaticResource SidebarButton}" Content="Biblioteca" />
                <Separator Margin="0,16" Background="#2E3443" />
                <Button Style="{StaticResource SidebarButton}" Content="Playlists" />
                <Button Style="{StaticResource SidebarButton}" Content="Álbumes" />
                <Button Style="{StaticResource SidebarButton}" Content="Modo Desarrollador" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Estadísticas locales" Foreground="#9DA3B4" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="●" Foreground="#FF5B2EFF" FontSize="20" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#FF151824" CornerRadius="16" Padding="20" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Canciones" Foreground="White" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Reproduce y administra tu biblioteca" Foreground="#9DA3B4" Margin="0,4,0,16" />
                        <ListBox x:Name="SongsList" Background="Transparent" BorderThickness="0" Foreground="White" Height="360" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="Reproducir" Width="120" Margin="0,0,8,0" Click="OnPlayClick" />
                            <Button x:Name="StopButton" Style="{StaticResource SidebarButton}" Content="Detener" Width="120" Click="OnStopClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="DeveloperPanel" Background="#FF151824" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Modo desarrollador" Foreground="White" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Agrega canciones con metadatos completos." Foreground="#9DA3B4" Margin="0,4,0,16" />
                                <TextBlock Text="Título" Foreground="#9DA3B4" />
                                <TextBox x:Name="TitleInput" Style="{StaticResource InputBox}" />
                                <TextBlock Text="Artista" Foreground="#9DA3B4" />
                                <TextBox x:Name="ArtistInput" Style="{StaticResource InputBox}" />
                                <TextBlock Text="Álbum" Foreground="#9DA3B4" />
                                <TextBox x:Name="AlbumInput" Style="{StaticResource InputBox}" />
                                <TextBlock Text="Archivo MP3" Foreground="#9DA3B4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="FileInput" Style="{StaticResource InputBox}" Width="220" />
                                    <Button Style="{StaticResource SidebarButton}" Content="Buscar" Margin="8,4,0,4" Click="OnBrowseMp3" />
                                </StackPanel>
                                <TextBlock Text="Imagen del álbum" Foreground="#9DA3B4" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="AlbumArtInput" Style="{StaticResource InputBox}" Width="220" />
                                    <Button Style="{StaticResource SidebarButton}" Content="Buscar" Margin="8,4,0,4" Click="OnBrowseArt" />
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Agregar canción" Margin="0,8,0,0" Click="OnAddSong" />
                            </StackPanel>
                        </Border>
                        <Border Background="#FF151824" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Álbumes" Foreground="White" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Nombre del álbum" Foreground="#9DA3B4" />
                                <TextBox x:Name="AlbumNameInput" Style="{StaticResource InputBox}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Crear álbum" Click="OnAddAlbum" />
                                <ListBox x:Name="AlbumsList" Background="Transparent" BorderThickness="0" Foreground="White" Height="120" />
                            </StackPanel>
                        </Border>
                        <Border Background="#FF151824" CornerRadius="16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Playlists" Foreground="White" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Nombre de la playlist" Foreground="#9DA3B4" />
                                <TextBox x:Name="PlaylistNameInput" Style="{StaticResource InputBox}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Crear playlist" Click="OnAddPlaylist" />
                                <ListBox x:Name="PlaylistsList" Background="Transparent" BorderThickness="0" Foreground="White" Height="120" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
